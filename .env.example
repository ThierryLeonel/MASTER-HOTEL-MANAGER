APP_NAME="Hotel Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database — MySQL/MariaDB is the only supported production connection.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hms
DB_USERNAME=hms_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Security-audit fix (Phase 7): defaults to true because every real
# deployment should be served over HTTPS — without this, the session
# cookie (a bearer credential for every logged-in account) can be sent in
# the clear over plain HTTP and sniffed on the network. Set to false only
# if your specific host genuinely cannot offer HTTPS at all, which should
# be rare and is itself a reason to reconsider the host.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HMS deployment helper (built in Phase 8 — see README.md §10 step 5 and
# app/Http/Controllers/DeployHelperController.php). A one-time,
# browser-based installer/migration runner for shared hosting with no SSH
# and no server-side Composer, reachable at /deploy-helper?token=... once
# enabled. MUST be false in normal operation. Only flip to true
# temporarily during initial deployment, run the migrate/seed steps from
# that page, then set back to false immediately (the page itself can also
# attempt to flip this for you automatically — see its "Disable now"
# button — but always verify it actually took effect).
# DEPLOY_TOKEN must be a long random string — generate a new one (e.g.
# `php artisan tinker --execute="echo bin2hex(random_bytes(32));"` on any
# machine that has this project installed, or any other secure random
# string generator), never reuse the example value below (the controller
# explicitly refuses that exact placeholder even if ENABLE_DEPLOY_HELPER
# is true), and never commit the real value.
# ---------------------------------------------------------------------------
ENABLE_DEPLOY_HELPER=false
DEPLOY_TOKEN=change-this-to-a-random-64-character-string

# ---------------------------------------------------------------------------
# HMS business policy defaults (all overridable at runtime via the
# Settings screen — Owner/GM only — which writes to the `settings` table.
# These env values only seed the settings table on first install; the
# settings table, not this file, is the source of truth at runtime).
# ---------------------------------------------------------------------------
HMS_CURRENCY=XAF
HMS_TAX_RATE_PERCENT=19.25
HMS_DEPOSIT_PERCENT=30
HMS_EXPENSE_APPROVAL_THRESHOLD=50000
HMS_SESSION_TIMEOUT_MINUTES=15
HMS_PIN_MAX_ATTEMPTS=5
HMS_PIN_LOCKOUT_MINUTES=15
HMS_PAYROLL_WORKING_DAYS_PER_MONTH=26
